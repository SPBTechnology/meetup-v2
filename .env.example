# ─────────────────────────────────────────────────────────────
# Local Supabase (v2 stack runs on the 544xx port range)
# Fill in from `supabase status`. Copy to .env — never commit .env.
# ─────────────────────────────────────────────────────────────

# Use the Mac's LAN IP (ipconfig getifaddr en0) so a physical phone can reach it.
# Node tooling (integration tests) rewrites the host to 127.0.0.1 automatically.
EXPO_PUBLIC_SUPABASE_URL=http://<LAN-IP>:54421
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/test use only — never referenced from app code, never EXPO_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
