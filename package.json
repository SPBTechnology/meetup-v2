{
  "name": "meetup-v2",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.2",
    "dotenv": "^18.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "supabase": "2.118.0",
    "test-renderer": "^1.3.0",
    "ts-jest": "^29.4.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "teardown": "bash scripts/teardown.sh",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:db": "supabase test db",
    "test:int": "jest --selectProjects integration --runInBand --forceExit",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:db && npm run db:types:check && npm run test:int",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.types.ts",
    "db:types:check": "bash scripts/check-types.sh",
    "maestro:setup": "bash scripts/setup-maestro.sh",
    "maestro:teardown": "bash scripts/teardown-maestro.sh",
    "test:e2e": "maestro test .maestro"
  },
  "private": true,
  "engines": {
    "node": ">=22 <23"
  }
}
